{
  "name": "RecordingStudio (Rails engine + PostgreSQL)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "web",
      "command": "cd /workspace/test/dummy && bin/rails server -b 0.0.0.0"
    },
    {
      "name": "css",
      "command": "cd /workspace/test/dummy && bin/rails tailwindcss:watch"
    }
  ],
  "ports": [3000, 5432]
}
