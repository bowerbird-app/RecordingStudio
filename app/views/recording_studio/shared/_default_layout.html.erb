<%
  rs_config = RecordingStudio.configuration
  app_name = (rs_config.respond_to?(:app_name) ? rs_config.app_name : nil).presence || "CHANGE_APP_NAME_IN_DEFAULT_LAYOUT"
  heading = content_for(:title).to_s.strip.presence
  subtitle = content_for(:subtitle).to_s.strip.presence
  background_image = content_for(:background_image).to_s.strip.presence
  page_width = content_for(:page_width).to_s.strip.presence&.to_sym || :default
  document_title = heading || app_name
  back_row = flat_pack_page_nav_tag
  page_buttons = page_nav_button_group(
    styles: {
      primary: {style: :ghost, size: :sm},
      secondary: {style: :ghost, size: :sm},
      destructive: {style: :ghost, size: :sm}
    },
    variant: :outlined,
    collapse: :menu
  )
  page_nav_right = content_for(:page_nav_right).presence
%>
<!DOCTYPE html>
<html data-theme="rounded">
  <head>
    <title><%= document_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% if lookup_context.exists?("recording_studio/default_layout_head", [], true) %>
      <%= render "recording_studio/default_layout_head" %>
    <% end %>
    <%= yield :head %>
    <% seo_description = content_for(:seo_description) %>
    <% if seo_description.present? %>
      <meta name="description" content="<%= seo_description %>">
      <meta property="og:description" content="<%= seo_description %>">
    <% end %>
    <meta property="og:title" content="<%= document_title %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <% site_name = rs_config.respond_to?(:app_name) ? rs_config.app_name : nil %>
    <meta property="og:site_name" content="<%= site_name.presence || document_title %>">
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
  </head>

  <body class="bg-(--surface-page-background-color) text-(--surface-content-color)" data-recording-studio-default-layout="true">
    <%= render FlatPack::PageLayout::Component.new(width: page_width) do |layout| %>
      <% if background_image.present? %>
        <% layout.background do %>
          <%= image_tag background_image, alt: "", loading: "lazy" %>
        <% end %>
      <% end %>

      <% if back_row || page_buttons || page_nav_right %>
        <% layout.top_nav do %>
          <%= render FlatPack::TopNav::Component.new(padding: :none, size: :lg) do |nav| %>
            <% nav.left { back_row } if back_row %>
            <% nav.right { safe_join([page_nav_right, page_buttons].compact) } if page_buttons || page_nav_right %>
          <% end %>
        <% end %>
      <% end %>

      <%# TODO: PageLayout main has no id, so SkipLink cannot target it. %>
      <% if flash[:notice].present? || flash[:alert].present? %>
        <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
          <% if flash[:notice].present? %>
            <%= render FlatPack::Alert::Component.new(description: flash[:notice], style: :success) %>
          <% end %>
          <% if flash[:alert].present? %>
            <%= render FlatPack::Alert::Component.new(description: flash[:alert], style: :danger) %>
          <% end %>
          <% if heading %>
            <%= render FlatPack::PageTitle::Component.new(title: heading, subtitle: subtitle) %>
          <% end %>
          <%= yield %>
        <% end %>
      <% else %>
        <% if heading %>
          <%= render FlatPack::PageTitle::Component.new(title: heading, subtitle: subtitle) %>
        <% end %>
        <%= yield %>
      <% end %>
    <% end %>
  </body>
</html>
