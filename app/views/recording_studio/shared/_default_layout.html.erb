<!DOCTYPE html>
<html>
  <head>
    <% rs_config = RecordingStudio.configuration %>
    <% app_name = (rs_config.respond_to?(:app_name) ? rs_config.app_name : nil) || "CHANGE_APP_NAME_IN_DEFAULT_LAYOUT" %>
    <% page_title = content_for(:title).presence || app_name %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <% if lookup_context.exists?("recording_studio/default_layout_head", [], true) %>
      <%= render "recording_studio/default_layout_head" %>
    <% end %>
    <%= yield :head %>
    <% seo_description = content_for(:seo_description) %>
    <% if seo_description.present? %>
      <meta name="description" content="<%= seo_description %>">
      <meta property="og:description" content="<%= seo_description %>">
    <% end %>
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <% site_name = rs_config.respond_to?(:app_name) ? rs_config.app_name : nil %>
    <meta property="og:site_name" content="<%= site_name.presence || page_title %>">
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
  </head>

  <body class="bg-(--surface-page-background-color) text-(--surface-content-color)" data-recording-studio-default-layout="true" data-theme="rounded">
    <main class="mx-auto min-h-screen w-full max-w-6xl p-6">
      <% if flash[:notice].present? %>
        <%= render FlatPack::Alert::Component.new(description: flash[:notice], style: :success, class: "mb-4") %>
      <% end %>
      <% if flash[:alert].present? %>
        <%= render FlatPack::Alert::Component.new(description: flash[:alert], style: :danger, class: "mb-4") %>
      <% end %>

      <% back_label = content_for(:page_nav_back_label).presence || RecordingStudio.t("recording_studio.core.navigation.go_back") %>
      <% anchor_label = content_for(:page_nav_anchor_label).presence || RecordingStudio.t("recording_studio.core.navigation.close") %>
      <% back_url = content_for(:page_nav_back_url).presence %>
      <% anchor_url = content_for(:page_nav_anchor_url).presence %>

      <div class="mt-4 mb-8">
        <% if defined?(FlatPack::PageNav::Component) %>
          <%= render FlatPack::PageNav::Component.new do |page_nav| %>
            <% page_nav.with_back(
              href: back_url,
              icon: "chevron-left",
              tooltip: back_label,
              style: :secondary,
              size: :md,
              fallback_url: anchor_url
            ) %>
            <% if anchor_url.present? %>
              <% page_nav.with_close(href: anchor_url, icon: "x-mark", tooltip: anchor_label) %>
            <% end %>
            <% if content_for?(:page_nav_right) %>
              <% page_nav.with_item do %>
                <div class="ml-auto flex items-center gap-2"><%= yield :page_nav_right %></div>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <nav aria-label="<%= RecordingStudio.t("recording_studio.core.navigation.page") %>" class="flex items-center justify-between gap-3">
            <div>
              <% if defined?(FlatPack::Button::Component) %>
                <% if back_url.present? %>
                  <%= render FlatPack::Button::Component.new(
                    icon: "chevron-left",
                    icon_only: true,
                    style: :secondary,
                    size: :md,
                    href: back_url,
                    aria: { label: back_label }
                  ) %>
                <% else %>
                  <button name="button" type="button" id="recording-studio-back-button" class="inline-flex items-center justify-center gap-2 rounded-[var(--button-border-radius)] font-medium cursor-pointer transition-colors duration-base focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--button-focus-ring-color)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--button-focus-ring-offset-color)] disabled:pointer-events-none disabled:opacity-[var(--button-disabled-opacity)] bg-[var(--button-secondary-background-color)] hover:bg-[var(--button-secondary-hover-background-color)] text-[var(--button-secondary-text-color)] border border-[var(--button-secondary-border-color)] p-[var(--button-icon-only-padding-md)]" aria-label="<%= back_label %>">
                    <svg class="inline-block w-5 h-5" data-controller="flat-pack--icon" data-flat-pack--icon-name-value="chevron-left" data-flat-pack--icon-variant-value="outline" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"></path></svg>
                  </button>
                  <%= javascript_tag nonce: true do %>
                    document.getElementById("recording-studio-back-button").addEventListener("click", function() {
                      history.back();
                    });
                  <% end %>
                <% end %>
                <% if anchor_url.present? %>
                  <%= render FlatPack::Button::Component.new(
                    icon: "x-mark",
                    icon_only: true,
                    style: :secondary,
                    size: :md,
                    href: anchor_url,
                    aria: { label: anchor_label },
                    class: "ml-2"
                  ) %>
                <% end %>
              <% else %>
                <% if back_url.present? %>
                  <a href="<%= back_url %>" class="inline-flex items-center gap-2 text-sm font-medium text-(--surface-content-color)">
                    <%= back_label %>
                  </a>
                <% else %>
                  <button onclick="history.back()" class="inline-flex items-center gap-2 text-sm font-medium text-(--surface-content-color) cursor-pointer">
                    <%= back_label %>
                  </button>
                <% end %>
                <% if anchor_url.present? %>
                  <a href="<%= anchor_url %>" class="inline-flex items-center gap-2 text-sm font-medium text-(--surface-content-color) ml-2">
                    <%= anchor_label %>
                  </a>
                <% end %>
              <% end %>
            </div>
            <% if content_for?(:page_nav_right) %>
              <div class="flex items-center justify-end">
                <%= yield :page_nav_right %>
              </div>
            <% end %>
          </nav>
        <% end %>
      </div>

      <%= yield %>
    </main>
  </body>
</html>
