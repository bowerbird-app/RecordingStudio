<%%# Intended layout: recording_studio/default_layout %>
<%% content_for :title, "<%= plural_name.humanize %>" %>
<%% content_for :subtitle, "Replace this list with your collection UI." %>
<%% flat_pack_page_nav(round: true) %>
<%% register_page_nav "New <%= human_name %>", new_<%= singular_route_helper %>_path, role: :primary, icon: :plus %>
<%%# Optional SEO / head helpers:
    recording_studio_seo_description("Browse <%= plural_name.humanize.downcase %>")
    default_layout_head do
      stylesheet_link_tag "custom/<%= file_name %>", "data-turbo-track": "reload"
    end
%>

<%%= render FlatPack::EmptyState::Component.new(
  title: "No <%= plural_name.humanize.downcase %> yet",
  description: "Add the first one to get started."
) %>
