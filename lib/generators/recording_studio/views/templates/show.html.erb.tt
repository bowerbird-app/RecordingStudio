<%%# Intended layout: recording_studio/default_layout %>
<%% content_for :title, "<%= human_name %>" %>
<%% content_for :subtitle, "Render your <%= human_name.downcase %> attributes here." %>
<%% flat_pack_page_nav(round: true,
  back_href: <%= plural_route_helper %>_path,
  back_tooltip: "<%= plural_name.humanize %>"
) %>
<%%# Optional SEO / head helpers:
    recording_studio_seo_description("<%= human_name %> details")
    default_layout_head do
      stylesheet_link_tag "custom/<%= file_name %>", "data-turbo-track": "reload"
    end
%>
