<%%# Intended layout: recording_studio/default_layout %>
<%% recording_studio_page_nav(
  title: "Edit <%= human_name %>",
  page_nav_back_url: <%= singular_route_helper %>_path(@<%= file_name %>),
  page_nav_back_label: "<%= human_name %>"
) %>
<%%# Optional SEO / head helpers:
    recording_studio_seo_description("Edit this <%= human_name.downcase %>")
    default_layout_head do
      stylesheet_link_tag "custom/<%= file_name %>", "data-turbo-track": "reload"
    end
%>

<%%= render FlatPack::PageTitle::Component.new(title: "Edit <%= human_name %>") %>
<%%= render "form", <%= file_name %>: @<%= file_name %> %>
