<%%# Intended layout: recording_studio/action_layout (typically used by new actions) %>
<%% content_for :title, "New <%= human_name %>" %>
<%%# Optional SEO / head helpers:
    recording_studio_seo_description("Create a new <%= human_name.downcase %>")
    content_for :head do
      stylesheet_link_tag "custom/<%= file_name %>", "data-turbo-track": "reload"
    end
%>

<%% content_for :top_nav_left do %>
  <%%= render "recording_studio/shared/page_nav",
        title: "New <%= human_name %>",
        back_path: <%= plural_route_helper %>_path,
        resource: "<%= class_name %>" %>
<%% end %>

<%% content_for :top_nav_center do %>
  <span class="text-sm opacity-70">Create</span>
<%% end %>

<%% content_for :top_nav_right do %>
  <%%= render FlatPack::Button::Component.new(
    text: "Cancel",
    href: <%= plural_route_helper %>_path,
    style: :ghost,
    size: :sm
  ) %>
<%% end %>

<%%= render FlatPack::PageTitle::Component.new(title: "New <%= human_name %>") %>
<%%= render "form", <%= file_name %>: @<%= file_name %> %>
