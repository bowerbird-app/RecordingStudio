<!DOCTYPE html>
<html data-theme="rounded">
  <head>
    <title><%= content_for(:title) || "RecordingStudio Sandbox" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dummy">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
  </head>

  <body class="bg-(--surface-page-background-color) text-(--surface-content-color)">
    <%= render FlatPack::SkipLink::Component.new(href: "#main") %>
    <%= turbo_stream_from "recording_studio_toasts" if respond_to?(:turbo_stream_from) %>
    <% if user_signed_in? %>
      <%= render FlatPack::SidebarLayout::Component.new do |layout| %>
        <% layout.sidebar do %>
          <%= render "layouts/flat_pack/sidebar" %>
        <% end %>

        <% layout.top_nav do %>
          <%= render "layouts/flat_pack/top_nav" %>
        <% end %>

        <% layout.main do %>
          <main id="main" tabindex="-1" class="fp-layout-content py-4 sm:py-8">
            <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
              <% if flash[:notice].present? %>
                <%= render FlatPack::Alert::Component.new(description: flash[:notice], style: :success) %>
              <% end %>
              <% if flash[:alert].present? %>
                <%= render FlatPack::Alert::Component.new(description: flash[:alert], style: :danger) %>
              <% end %>
              <% page_actions = page_nav_button_group(styles: FlatPack::PageNavRoleStyles::SOLID, collapse: :menu) %>
              <%= page_actions if page_actions.present? %>
              <%= yield %>
            <% end %>
          </main>
        <% end %>
      <% end %>
    <% else %>
      <div class="h-screen overflow-y-auto overscroll-y-contain">
        <main id="main" tabindex="-1" class="fp-layout-content flex min-h-full w-full items-center justify-center py-8">
          <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg, class: "w-full") do %>
            <% if flash[:notice].present? %>
              <%= render FlatPack::Alert::Component.new(description: flash[:notice], style: :success) %>
            <% end %>
            <% if flash[:alert].present? %>
              <%= render FlatPack::Alert::Component.new(description: flash[:alert], style: :danger) %>
            <% end %>
            <%= yield %>
          <% end %>
        </main>
      </div>
    <% end %>
    <%= render FlatPack::Toasts::Region::Component.new(id: "toast-container", data: { turbo_permanent: true }) %>
  </body>
</html>
