<% content_for :title, "Tree" %>

<%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
<%= render FlatPack::Breadcrumb::Component.new do |breadcrumb| %>
  <% breadcrumb.item(text: "Home", href: root_path) %>
  <% breadcrumb.item(text: "Tree") %>
<% end %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Tree",
  subtitle: "Browse the dummy app recording hierarchy as a Flatpack tree of workspaces, folders, and pages.",
) %>

<%# TODO: Card has no max-width prop. %>
<%= render FlatPack::Card::Component.new do |card| %>
  <% card.body do %>
    <% if @recordings.any? %>
      <%= render FlatPack::Tree::Component.new(compact: true) do |tree| %>
        <% render_recording_tree_nodes(tree, @recordings_by_parent) %>
      <% end %>
    <% else %>
      <%= render FlatPack::Alert::Component.new(description: "No recordings yet.", style: :info) %>
    <% end %>
  <% end %>
<% end %>
<% end %>
