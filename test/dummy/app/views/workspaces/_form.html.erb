<%= form_with model: workspace do |_form| %>
  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg) do %>
  <%= render FlatPack::TextInput::Component.new(
    name: "workspace[name]",
    label: "Name",
    value: workspace.name
  ) %>

  <%= render FlatPack::Collection::Component.new(layout: :wrap, gap: :sm) do |actions| %>
    <% actions.with_item do %>
      <%= render FlatPack::Button::Component.new(text: "Create Workspace", type: "submit", style: :primary) %>
    <% end %>
    <% actions.with_item do %>
      <%= render FlatPack::Button::Component.new(text: "Cancel", href: workspaces_path, style: :secondary) %>
    <% end %>
  <% end %>
  <% end %>
<% end %>
