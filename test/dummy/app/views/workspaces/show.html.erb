<% content_for :title, @workspace.name %>
<% content_for :subtitle, "A workspace root recording with explicit page routes and its full recording tree." %>
<% flat_pack_page_nav(
  back_href: workspaces_path,
  back_tooltip: "Workspaces",
  anchor_href: root_path,
  anchor_tooltip: "Home"
) %>
<% page_action "Browse Pages", workspace_pages_path(@workspace), role: :secondary %>
<% page_action "New Page", new_workspace_page_path(@workspace), role: :primary %>
<% page_action "Browse Recordings", recordings_path, role: :secondary %>

<%= render FlatPack::Card::Component.new(class: "mb-6", padding: :none) do |card| %>
  <% card.header(divider: false) do %>
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Recording hierarchy",
      subtitle: "Child recordings nested under their parents.",
      class: "my-0"
    ) %>
  <% end %>

  <% card.body do %>
    <% if @recordings.any? %>
      <%= recordings_hierarchy_list(@recordings_by_parent, parent_id: @root_recording.id) %>
    <% else %>
      <%= render FlatPack::Alert::Component.new(description: "No recordings yet.", style: :info) %>
    <% end %>
  <% end %>
<% end %>
