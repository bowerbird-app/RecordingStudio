<% content_for :title, @workspace.name %>
<% flat_pack_page_nav(
  back_href: workspaces_path,
  back_tooltip: "Workspaces",
  anchor_href: root_path,
  anchor_tooltip: "Home"
) %>

<%= render FlatPack::PageTitle::Component.new(
  title: @workspace.name,
  subtitle: "A workspace root recording with explicit page routes and its full recording tree."
) do |page_title| %>
  <% page_title.actions do %>
    <%= render FlatPack::Button::Component.new(text: "Back to Workspaces", style: :secondary, href: workspaces_path) %>
    <%= render FlatPack::Button::Component.new(text: "Browse Pages", style: :secondary, href: workspace_pages_path(@workspace)) %>
    <%= render FlatPack::Button::Component.new(text: "New Page", style: :primary, href: new_workspace_page_path(@workspace)) %>
    <%= render FlatPack::Button::Component.new(text: "Browse Recordings", style: :secondary, href: recordings_path) %>
  <% end %>
<% end %>

<%= render FlatPack::Card::Component.new(class: "mb-6", padding: :none) do |card| %>
  <% card.header(divider: false) do %>
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Recording hierarchy",
      subtitle: "Child recordings nested under their parents.",
      class: "my-0"
    ) %>
  <% end %>

  <% card.body do %>
    <% if @recordings.any? %>
      <%= recordings_hierarchy_list(@recordings_by_parent, parent_id: @root_recording.id) %>
    <% else %>
      <%= render FlatPack::Alert::Component.new(description: "No recordings yet.", style: :info) %>
    <% end %>
  <% end %>
<% end %>
