<% content_for :title, "New Workspace" %>
<% content_for :subtitle, "Create a container for recordings." %>
<% flat_pack_page_nav %>

<%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg, class: "") do %>
  <%= render FlatPack::Card::Component.new do |card| %>
    <% card.body do %>
      <%= render "form", workspace: @workspace %>
    <% end %>
  <% end %>
<% end %>
